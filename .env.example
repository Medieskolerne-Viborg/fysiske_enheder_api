# Kopiér til .env.local og udfyld. Disse må ALDRIG committes.
# På DigitalOcean sættes de i stedet som Environment Variables (scope: Run time).

# MongoDB — hele forbindelsesstrengen (skift /admin ud med fx /mcdm i stien)
MONGODB_URI=mongodb+srv://USER:PASSWORD@db-mongodb-xxx.ondigitalocean.com/mcdm?tls=true&authSource=admin

# DigitalOcean Space (S3-kompatibelt)
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
SPACES_REGION=fra1
SPACES_BUCKET=medieskolerne
SPACES_KEY=din-spaces-access-key
SPACES_SECRET=din-spaces-secret
# Valgfri: CDN-base, hvis du har slået CDN til på dit Space
SPACES_PUBLIC_BASE=
# Valgfri: mappe (nøgle-præfiks) i Space'et. Standard: mcd_viborg
SPACES_FOLDER=mcd_viborg

# Valgfri: beskyt upload/slet. Er den sat, kræves headeren x-upload-token
UPLOAD_TOKEN=

# Nøgle til news-feedet (apitube). Ligger KUN her på serveren - aldrig i frontenden.
NEWS_API_KEY=https://api.apitube.io/v1/news/everything?language.code=en&per_page=10&api_key=api_live_QCmPstvfsAjZkeSD6vTPIFF3Ff4oZvxcAdUYETbBTH
